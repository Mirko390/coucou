<Project Sdk="Microsoft.NET.Sdk">

  <!--
    coucou-hook.exe — the relay Claude Code runs on every hook event.

    Claude Code spawns it for every tool call, so it is published Native AOT:
    one small exe that starts in a few milliseconds and needs no .NET runtime.
    That needs the MSVC linker (Visual Studio Build Tools, "Desktop development
    with C++") at publish time only; `dotnet build` works without it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>coucou-hook</AssemblyName>
    <RootNamespace>Coucou.Hook</RootNamespace>
    <Description>Relays Claude Code hook events to Coucou over a named pipe</Description>

    <PublishAot>true</PublishAot>
    <!-- Restored for both up front, so a plain `dotnet build` and an AOT publish
         never fight over obj/project.assets.json. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\shared\RelayPipeName.cs" Link="Shared\RelayPipeName.cs" />
  </ItemGroup>

</Project>
