<Project>
  <!--
    Shared by the app, the hook relay and the tests. The version lives here and
    nowhere else: the app reports it at boot, the installer stamps it, and the
    release workflow checks the tag against it.
  -->
  <PropertyGroup>
    <Version>0.4.4</Version>
    <Product>Coucou</Product>
    <Authors>Louis Raille</Authors>
    <Company>Louis Raille</Company>
    <Copyright>© Louis Raille</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Hand-written LibraryImport declarations; no interop package needed. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
